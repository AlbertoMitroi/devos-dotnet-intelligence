{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlbertoMitroi/dotnet-intelligence/schema/v1/entity.schema.json",
  "title": "Entity",
  "type": "object",
  "required": [
    "id",
    "kind",
    "name",
    "container",
    "signature",
    "accessibility",
    "modifiers",
    "origin"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(dotnet|ts):"
    },
    "kind": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "container": {
      "type": [
        "string",
        "null"
      ]
    },
    "signature": {
      "type": "string"
    },
    "accessibility": {
      "type": "string"
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "origin": {
      "enum": [
        "source",
        "generated",
        "metadata"
      ]
    },
    "documentationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "assembly": {
      "type": [
        "string",
        "null"
      ]
    },
    "namespace": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
