{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlbertoMitroi/devos-intelligence-contract/schema/v1/kinds/realtime.connection.schema.json",
  "title": "Observation realtime.connection (client connection to a real-time hub)",
  "type": "object",
  "required": [
    "kind",
    "route",
    "urlTemplate",
    "baseAddress",
    "client",
    "resolution"
  ],
  "properties": {
    "kind": {
      "const": "realtime.connection"
    },
    "route": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^/"
    },
    "urlTemplate": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseAddress": {
      "type": [
        "object",
        "null"
      ]
    },
    "client": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ts:"
    },
    "resolution": {
      "enum": [
        "exact",
        "ambiguous",
        "candidate",
        "unresolved"
      ]
    }
  },
  "additionalProperties": true
}
