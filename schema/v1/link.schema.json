{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlbertoMitroi/dotnet-intelligence/schema/v1/link.schema.json",
  "title": "Link",
  "type": "object",
  "required": [
    "id",
    "kind",
    "via",
    "from",
    "to",
    "resolution",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^lnk:[0-9a-f]{32}$"
    },
    "kind": {
      "type": "string",
      "description": "Kinds are listed in docs/CONTRACT-v1.0.md, v1.1 and v1.2; unknown kinds from newer minors are kept and reported, not rejected (compatibility rule 4)."
    },
    "via": {
      "enum": [
        "http",
        "grpc",
        "messaging",
        "di",
        "inprocess",
        "workflow",
        "realtime",
        "ui",
        "package"
      ]
    },
    "from": {
      "type": "object",
      "required": [
        "observation",
        "kind",
        "project"
      ]
    },
    "to": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "observation",
        "kind",
        "project"
      ]
    },
    "resolution": {
      "enum": [
        "exact",
        "ambiguous",
        "candidate",
        "unresolved"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ev:[0-9a-f]{32}$"
      },
      "minItems": 1
    },
    "reason": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "repository",
        "system"
      ],
      "description": "v1.2: `system` for links a federation adds across inputs (schema/system/v1/system-link.schema.json); absent means `repository`."
    }
  },
  "additionalProperties": true
}
