{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlbertoMitroi/dotnet-intelligence/schema/v1/observation.schema.json",
  "title": "Observation",
  "type": "object",
  "required": [
    "id",
    "kind",
    "project",
    "context",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^obs:[0-9a-f]{32}$"
    },
    "kind": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "context": {
      "type": "string",
      "pattern": "^ctx:[0-9a-f]{32}$"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ev:[0-9a-f]{32}$"
      },
      "minItems": 1
    },
    "site": {
      "type": "string",
      "pattern": "^ev:[0-9a-f]{32}$",
      "description": "v1.2: the evidence id (one of `evidence`) at the exact location of the fact; indexes take the observation's path and line from it."
    },
    "destinationParameter": {
      "type": "object",
      "description": "v1.2: the destination field of this observation is a parameter of the member that contains it; call sites carry the value in `call.argument` observations.",
      "required": [
        "field",
        "parameter",
        "ordinal"
      ],
      "properties": {
        "field": {
          "type": "string"
        },
        "parameter": {
          "type": "string"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "additionalProperties": true
}
