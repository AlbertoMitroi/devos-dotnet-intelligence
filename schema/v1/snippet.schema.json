{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlbertoMitroi/dotnet-intelligence/schema/v1/snippet.schema.json",
  "title": "Snippet",
  "type": "object",
  "required": [
    "id",
    "blobId",
    "line",
    "text"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^snip:[0-9a-f]{32}$"
    },
    "blobId": {
      "type": "string"
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "text": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
