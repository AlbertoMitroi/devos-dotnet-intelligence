{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlbertoMitroi/devos-intelligence-contract/schema/query/v1/impl.schema.json",
  "title": "query impl",
  "type": "array",
  "items": {
    "required": [
      "kind",
      "from_id",
      "path",
      "line"
    ],
    "properties": {
      "kind": {
        "type": "string"
      },
      "from_id": {
        "type": "string"
      },
      "path": {
        "type": [
          "string",
          "null"
        ]
      },
      "line": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1
      }
    },
    "type": "object",
    "additionalProperties": true
  }
}
