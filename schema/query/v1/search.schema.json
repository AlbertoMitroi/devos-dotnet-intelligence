{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlbertoMitroi/devos-intelligence-contract/schema/query/v1/search.schema.json",
  "title": "query search",
  "type": "array",
  "items": {
    "required": [
      "ref",
      "kind",
      "text"
    ],
    "properties": {
      "ref": {
        "type": "string"
      },
      "kind": {
        "enum": [
          "entity",
          "snippet",
          "observation"
        ]
      },
      "text": {
        "type": "string"
      },
      "at": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^.+:[0-9]+$"
      }
    },
    "type": "object",
    "additionalProperties": true
  }
}
