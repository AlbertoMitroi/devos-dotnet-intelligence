<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- The major version of the SDK that evaluated this project becomes a preprocessor symbol (SDK_MAJOR_8, ...). -->
    <DefineConstants>$(DefineConstants);SDK_MAJOR_$([System.Version]::Parse('$(NETCoreSdkVersion)').Major)</DefineConstants>
  </PropertyGroup>
</Project>
